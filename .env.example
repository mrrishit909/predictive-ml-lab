# Copy to .env and fill in real values; never commit the real .env file.
# All values below are placeholders, not real secrets.

# API_HOST=0.0.0.0
# API_PORT=8000

# Comma-separated list of keys accepted in the X-API-Key header on
# POST /predict and /predict/batch. Required for those two endpoints only;
# GET endpoints are open. Generate real keys with e.g. `openssl rand -hex 32`.
API_KEYS=replace-with-a-real-generated-key,replace-with-a-second-key

# Postgres connection string for prediction logging. If unset (or the DB is
# unreachable), the API runs in a degraded "no logging" mode: it logs a
# warning and still serves /predict normally. See db/init.sql for the schema.
DATABASE_URL=postgresql://predictive:replace-with-a-real-password@localhost:5432/predictive

# Redis URL for the fixed-window rate limiter (60 requests/min per API key)
# on /predict and /predict/batch. If unset, rate limiting is a documented
# no-op - it is literally skipped, not faked.
REDIS_URL=redis://localhost:6379/0
